        <path d="M0 118 Q 220 92 460 110 T 900 108 T 1340 116 T 1600 110 L1600 160 L0 160 Z" fill="hsl(var(--story-accent) / 0.07)"/>
        <path d="M0 134 Q 260 116 560 130 T 1120 128 T 1600 134 L1600 160 L0 160 Z" fill="hsl(var(--story-accent) / 0.11)"/>
